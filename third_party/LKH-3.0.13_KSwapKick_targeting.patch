+static void TgBuildPool()
+{
+    Node *N = FirstNode;
+    int n = 0;
+
+    do {
+        double dx = N->X - N->Suc->X, dy = N->Y - N->Suc->Y;
+        TgScore[n] = sqrt(dx * dx + dy * dy) -
+            0.5 * (TgDref[N->Id] + TgDref[N->Suc->Id]);
+        TgEdge[n++] = N;
+    } while ((N = N->Suc) != FirstNode);
+    TgM = (int) (TgFrac * n);
+    if (TgM < 12)
+        TgM = 12;
+    if (TgM > n)
+        TgM = n;
+    TgSelect(0, n - 1, TgM - 1);
+}
