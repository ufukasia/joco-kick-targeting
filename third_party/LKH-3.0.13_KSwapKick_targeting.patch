+/* Partial selection: afterwards the k largest scores are in positions 0..k-1 */
+static void TgSelect(int lo, int hi, int k)
+{
+    while (lo < hi) {
+        double pivot = TgScore[(lo + hi) / 2];
+        int i = lo, j = hi;
+        while (i <= j) {
+            while (TgScore[i] > pivot)
+                i++;
+            while (TgScore[j] < pivot)
+                j--;
+            if (i <= j) {
+                double t = TgScore[i];
+                Node *T = TgEdge[i];
+                TgScore[i] = TgScore[j];
+                TgEdge[i] = TgEdge[j];
+                TgScore[j] = t;
+                TgEdge[j] = T;
+                i++;
+                j--;
+            }
+        }
+        if (k <= j)
+            hi = j;
+        else if (k >= i)
+            lo = i;
+        else
+            return;
+    }
+}
